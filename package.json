{
  "name":"rgb-multiplayer",
  "version":"0.2.1",
  "private":true,
  "type":"module",
  "description":"Browser-hosted Phaser multiplayer party game with mobile controllers",
  "scripts":{
    "dev":"concurrently -k npm:dev:server npm:dev:client",
    "dev:server":"node --watch server/index.js",
    "dev:client":"vite --host 0.0.0.0",
    "build":"vite build",
    "start":"cross-env NODE_ENV=production node server/index.js",
    "test":"vitest run",
    "test:watch":"vitest"
  },
  "dependencies":{
    "dotenv":"^16.4.7",
    "express":"^4.21.2",
    "express-rate-limit":"^7.5.0",
    "phaser":"^3.90.0",
    "qrcode":"^1.5.4",
    "socket.io":"^4.8.1",
    "socket.io-client":"^4.8.1",
    "zod":"^4.6.7"
  },
  "devDependencies":{
    "concurrently":"^9.1.2",
    "cross-env":"^7.0.3",
    "vite":"^6.1.0",
    "vitest":"^5.1.1"
  }
}
